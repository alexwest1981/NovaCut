{
  "id": "cyberpunk-neon",
  "name": "Cyberpunk Neon",
  "version": "1.0.0",
  "author": "NovaCut Team",
  "category": "filter",
  "description": "Electric cyan & magenta neon tint with elevated contrast and glow",
  "previewColor": "#00f0ff",
  "cssFilter": "contrast(140%) saturate(160%) hue-rotate(180deg)",
  "params": [
    { "id": "intensity", "label": "Glow Intensity", "type": "slider", "min": 0, "max": 2, "step": 0.1, "default": 1.2 },
    { "id": "contrast", "label": "Contrast", "type": "slider", "min": 80, "max": 200, "step": 5, "default": 140 },
    { "id": "tintColor", "label": "Neon Accent", "type": "color", "default": "#00f0ff" }
  ]
}
